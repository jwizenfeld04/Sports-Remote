{
  "name": "sports-remote",
  "version": "0.2.0-dev",
  "type": "module",
  "description": "Tap a live NFL, NBA, MLB or NHL game on your phone and it opens on your Fire TV or Google TV in the right app.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/main.ts",
    "build": "npm run build:ui && npm run build:server",
    "build:ui": "vite build",
    "build:server": "esbuild server/main.ts server/cli.ts --bundle --platform=node --target=node24 --format=esm --packages=external --sourcemap --outdir=dist/server --out-extension:.js=.mjs --log-level=warning",
    "start": "node --enable-source-maps dist/server/main.mjs",
    "tv": "tsx server/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vite build && playwright test"
  },
  "dependencies": {
    "@fastify/static": "10.1.7",
    "fastify": "5.12.7",
    "multicast-dns": "7.2.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/multicast-dns": "7.2.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jwizenfeld04/Sports-Remote.git"
  },
  "keywords": [
    "fire-tv",
    "google-tv",
    "android-tv",
    "adb",
    "sports",
    "self-hosted",
    "nfl",
    "nba",
    "mlb",
    "nhl"
  ]
}
